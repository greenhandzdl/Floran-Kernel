# Floran Kernel - Docker / container engine support (CORE)
# 该片段在 docker 开关开启时被追加到 arch/arm64/configs/gki_defconfig。
# 只包含 Docker 运行所必需的核心能力：namespace / cgroup v2 控制器 / overlay & 存储驱动。
# 均以 =y 内建方式启用，避免依赖未随 Image 打包的模块。
#
# 高级网络（bridge / veth / nftables / iptables / IPVS / SCTP / XFRM）已拆分到
# patch/docker-net.config，由 docker_net 开关单独控制。排查 bootloop 的动机：
# 这些网络项会改写 struct net / sock / sk_buff 布局，Qualcomm 启动关键的数据面
# 模块（IPA / rmnet / wifi）按冻结的 GKI 结构体偏移编译，结构体一旦变化就可能
# 在早期 probe 阶段错乱，表现为卡第一屏。Docker 走 --network=host 时无需网络组。

# ---- namespaces & cgroup v2 controllers ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NETCLASSID=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INET=y

# ---- overlay / storage drivers ----
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
