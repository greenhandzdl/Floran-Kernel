# Floran Kernel - Docker cgroup 可选/遗留项（Docker 不需要也能跑）
# 由 docker_cgroup_opt 开关控制（仅 docker=true 且 docker_cgroup=true 时生效）。
# 这批对 Docker 非必需，bootloop 二分时优先怀疑并可安全丢弃：
#   CGROUP_PERF       - perf 事件按 cgroup 过滤，容器不需要
#   CGROUP_HUGETLB    - 大页控制器，Android 上一般无巨页用途
#   NET_CLS_CGROUP    - cgroup v1 网络分类器（v2 已废弃，被 eBPF 取代）
#   CGROUP_NETCLASSID - net_cls classid，同样 cgroup v1 遗留
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NETCLASSID=y
