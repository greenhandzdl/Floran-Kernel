# Floran Kernel - Docker 额外 cgroup 控制器 / 调度带宽 / 网络分类器（可独立关闭以二分 bootloop）
# 这批是"C 能开机、D 不能"的头号嫌疑：Android init / libprocessgroup 对
# cgroup 控制器集合与 CFS 调度器行为很敏感，改动后可能让 init 早期分组失败卡第一屏。
# 由 docker_cgroup 开关独立控制（仅 docker=true 时生效）。

CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NETCLASSID=y
